# ---- AI providers (server-only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ---- Real stock footage (free): https://www.pexels.com/api/ ----
PEXELS_API_KEY=
# 3D camera engine for AI scenes: parallax (default) or kenburns
CAMERA_ENGINE=parallax

# ---- Storage: "local" (writes to ./storage) or "r2" ----
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vidlore

# ---- Render: "local" (worker venv), "docker" or "cloudrun" ----
RENDER_DRIVER=local
WORKER_PYTHON=./worker/.venv/Scripts/python.exe

# ---- Web app (server-only secrets; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
RENDER_WEBHOOK_SECRET=
FILE_SIGNING_SECRET=
CLIENT_HASH_SALT=
# Public URL the render worker calls back (defaults to the request origin)
APP_URL=
# Optional overrides of the daily demo caps
DAILY_LIMIT_PER_VISITOR=
DAILY_LIMIT_GLOBAL=
# Optional: full paths if ffmpeg/ffprobe are not on PATH
FFMPEG=
FFPROBE=
