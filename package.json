{
  "name": "vidlore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "render:fixture": "tsx scripts/render-fixture.ts",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "setup:env": "tsx scripts/setup-env.ts",
    "dev": "pnpm --filter @vidlore/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "@vidlore/core": "workspace:*",
    "typescript": "^5.7.2"
  }
}
